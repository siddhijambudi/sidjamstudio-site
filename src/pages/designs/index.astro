---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import { designs, mailtoFor, whatsappFor, CONTACT_EMAIL, ETSY_URL, WHATSAPP_DISPLAY, WHATSAPP_USERNAME, PRICING } from '../../data/designs';

// Add a content hash to each mockup URL so browsers fetch a fresh copy whenever an image changes.
const imgUrl = (slug: string, color: 'black' | 'white') => {
  const file = `public/images/designs/${slug}-${color}.jpg`;
  const v = createHash('md5').update(readFileSync(file)).digest('hex').slice(0, 8);
  return `/images/designs/${slug}-${color}.jpg?v=${v}`;
};
---
<Base title="Designs" description="Indian folk art meets streetwear: original tee designs from SidJam Studio. Email us to order, or ask for a custom design.">
  <section class="page-head">
    <span class="kicker">Wearable art</span>
    <h1>Indian folk art, <em>worn loud.</em></h1>
    <p class="lead">
      Warli, Madhubani, Pattachitra, Kalamkari and more, redrawn with a streetwear attitude and
      printed on black or white tees. See something you like? Email or WhatsApp us and we'll take it from there.
    </p>
    <div class="price-pill" aria-label="Pricing">
      <span><strong>1 tee</strong> ${PRICING.one}</span>
      <span class="dot" aria-hidden="true">·</span>
      <span><strong>2 tees</strong> ${PRICING.two}</span>
      <span class="price-note">front print on a classic crew-neck tee · mix &amp; match designs and colors</span>
    </div>
    <div class="extras">
      <h2 class="extras-title">Costs a little more <span>message us for a quote</span></h2>
      <ul>
        <li><strong>Front + back print</strong><span>a design on both sides of the tee</span></li>
        <li><strong>Women's V-neck tee</strong><span>a fitted V-neck instead of the classic crew neck</span></li>
        <li><strong>Custom design</strong><span>you bring the idea or photo, we draw it in folk-art style</span></li>
        <li><strong>Concept + design</strong><span>tell us the occasion or person, we come up with the idea and design it</span></li>
      </ul>
      <p class="bulk-note"><strong>Ordering 3 or more?</strong> Family, team, event or shop order: message us for bulk pricing.</p>
    </div>
    <div class="actions">
      <a class="btn primary" href={mailtoFor()}>Ask for a custom design</a>
      <a class="btn whatsapp" href={whatsappFor()} rel="noopener" target="_blank">Chat on WhatsApp</a>
      <a class="btn ghost" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>
    <p class="contact-line">WhatsApp: <a href={whatsappFor()} rel="noopener" target="_blank">{WHATSAPP_DISPLAY}</a> · username <strong>@{WHATSAPP_USERNAME}</strong></p>
  </section>

  <section>
    <h2 class="section-title">The designs</h2>
    <div class="design-grid">
      {designs.map((d) => (
        <article class={`design-card accent-${d.accent}`} data-design>
          <div class="design-img">
            <img src={imgUrl(d.slug, 'black')} alt={`${d.title} design on a black tee`} loading="lazy" width="1000" height="1000" data-black={imgUrl(d.slug, 'black')} data-white={imgUrl(d.slug, 'white')} />
          </div>
          <div class="design-body">
            <span class="tag">{d.art} · {d.region}</span>
            <h3>{d.title}</h3>
            <div class="swatches" role="group" aria-label="Tee color">
              <button type="button" class="swatch black" data-color="black" aria-pressed="true" aria-label="Show on black tee"></button>
              <button type="button" class="swatch white" data-color="white" aria-pressed="false" aria-label="Show on white tee"></button>
            </div>
            <span class="design-price">${PRICING.one} · 2 for ${PRICING.two}</span>
            <a class="btn primary small" href={mailtoFor(d.title)}>Email us about this design</a>
            <a class="btn whatsapp small" href={whatsappFor(d.title)} rel="noopener" target="_blank">WhatsApp us</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="studio-band how-band">
    <div>
      <span class="kicker">How ordering works</span>
      <h2>Just email or WhatsApp us.</h2>
      <p>
        Tees are <strong>${PRICING.one} for one</strong> or <strong>${PRICING.two} for two</strong> (mix and match). Front + back prints, women's V-necks, custom designs and concept + design cost a little more; we'll quote you. Ordering 3 or more? Ask us for bulk pricing.
        Tell us the design, the tee color (black or white), your size and how many. We'll reply
        with how to pay, and print it for you. No account, no checkout.
      </p>
    </div>
    <ul class="roadmap">
      <li><strong>1. Pick a design</strong><span>from this page</span></li>
      <li><strong>2. Email or WhatsApp us</strong><span>{CONTACT_EMAIL} · {WHATSAPP_DISPLAY} (@{WHATSAPP_USERNAME})</span></li>
      <li><strong>3. We reply</strong><span>payment details · ${PRICING.one} for 1, ${PRICING.two} for 2</span></li>
    </ul>
  </section>

  <section class="studio-band custom-band">
    <div>
      <span class="kicker">Also from SidJam Studio</span>
      <h2>Our Etsy shop: work &amp; job humor tees</h2>
      <p>
        Over on <a href={ETSY_URL} rel="noopener">our Etsy shop</a> we sell funny tees for the workday: witty, sarcastic lines and animal characters
        about meetings, emails and deadlines, made for anyone who works for a living.
        If you like one, email us the listing name at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and we'll sort it out.
        We can also create a custom design from your idea, your family's story, or a favorite art form.
      </p>
      <div class="actions">
        {ETSY_URL && <a class="btn ghost" href={ETSY_URL} rel="noopener">Visit our Etsy shop</a>}
        <a class="btn primary" href={mailtoFor()}>Start a custom design</a>
      </div>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-design]').forEach(function (card) {
      var img = card.querySelector('img');
      card.querySelectorAll('.swatch').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var c = btn.getAttribute('data-color');
          img.src = img.getAttribute('data-' + c);
          img.alt = img.alt.replace(/on a (black|white) tee/, 'on a ' + c + ' tee');
          card.querySelectorAll('.swatch').forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
        });
      });
    });
  </script>
</Base>
