---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import { designs, mailtoFor, whatsappFor, CONTACT_EMAIL, ETSY_URL, WHATSAPP_NUMBER, WHATSAPP_DISPLAY, WHATSAPP_USERNAME, PRICING, BULK, SIZES, STRIPE_LINKS } from '../../data/designs';
import { LOCAL_ZIPS, LOCAL_AREA } from '../../data/local-zips';

// Add a content hash to each mockup URL so browsers fetch a fresh copy whenever an image changes.
const imgUrl = (slug: string, color: 'black' | 'white') => {
  const file = `public/images/designs/${slug}-${color}.jpg`;
  const v = createHash('md5').update(readFileSync(file)).digest('hex').slice(0, 8);
  return `/images/designs/${slug}-${color}.jpg?v=${v}`;
};
---
<Base title="Designs" description="Indian folk art meets streetwear: original tee designs from SidJam Studio. Email us to order, or ask for a custom design.">
  <section class="page-head">
    <span class="kicker">Wearable art</span>
    <h1>Indian folk art, <em>worn loud.</em></h1>
    <p class="lead">
      Warli, Madhubani, Pattachitra, Kalamkari and more, redrawn with a streetwear attitude and
      printed on black or white tees. See something you like? Email or WhatsApp us and we'll take it from there.
    </p>
    <div class="price-pill" aria-label="Pricing">
      <span><strong>1 tee</strong> ${PRICING.one}</span>
      <span class="dot" aria-hidden="true">·</span>
      <span><strong>2 tees</strong> ${PRICING.two}</span>
      <span class="dot" aria-hidden="true">·</span>
      <span><strong>3–9 tees</strong> ${BULK.each} each</span>
      <span class="dot" aria-hidden="true">·</span>
      <span><strong>{BULK.bigFrom}+ tees</strong> ${BULK.bigEach} each</span>
      <span class="price-note">front print on a classic crew-neck tee · mix &amp; match designs and colors</span>
    </div>
    <div class="extras">
      <h2 class="extras-title">Costs a little more <span>message us for a quote</span></h2>
      <ul>
        <li><strong>Front + back print</strong><span>a design on both sides of the tee</span></li>
        <li><strong>Women's V-neck tee</strong><span>a fitted V-neck instead of the classic crew neck</span></li>
        <li><strong>Custom design</strong><span>you bring the idea or photo, we draw it in folk-art style</span></li>
        <li><strong>Concept + design</strong><span>tell us the occasion or person, we come up with the idea and design it</span></li>
      </ul>
      <p class="bulk-note"><strong>Ordering for family, a team or an event?</strong> 3 to 9 tees are ${BULK.each} each, {BULK.bigFrom} or more are ${BULK.bigEach} each. Just add them all to your basket.</p>
    </div>
    <div class="actions">
      <a class="btn primary" href={mailtoFor()}>Ask for a custom design</a>
      <a class="btn whatsapp" href={whatsappFor()} rel="noopener" target="_blank">Chat on WhatsApp</a>
      <a class="btn ghost" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>
    <p class="contact-line">WhatsApp: <a href={whatsappFor()} rel="noopener" target="_blank">{WHATSAPP_DISPLAY}</a> · username <strong>@{WHATSAPP_USERNAME}</strong></p>
  </section>

  <section class="studio-band custom-band">
    <div>
      <span class="kicker">Also from SidJam Studio</span>
      <h2>Our Etsy shop: work &amp; job humor tees</h2>
      <p>
        Over on <a href={ETSY_URL} rel="noopener">our Etsy shop</a> we sell funny tees for the workday: witty, sarcastic lines and animal characters
        about meetings, emails and deadlines, made for anyone who works for a living.
        If you like one, email us the listing name at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and we'll sort it out.
      </p>
      <p class="mix-note">
        <strong>Mix and match with our Indian folk art designs, same prices.</strong> Etsy tees count together with the designs below:
        ${PRICING.one} for 1, ${PRICING.two} for 2, ${BULK.each} each for 3 to {BULK.bigFrom - 1}, ${BULK.bigEach} each for {BULK.bigFrom} or more.
        Add the folk art tees to your basket, then list your Etsy picks in the basket's “Etsy tees” box and we'll count them in.
      </p>
      <p>
        We can also create a custom design from your idea, your family's story, or a favorite art form.
      </p>
      <div class="actions">
        {ETSY_URL && <a class="btn ghost" href={ETSY_URL} rel="noopener">Visit our Etsy shop</a>}
        <a class="btn primary" href={mailtoFor()}>Start a custom design</a>
      </div>
    </div>
  </section>

  <section>
    <h2 class="section-title">The designs</h2>
    <div class="design-grid">
      {designs.map((d) => (
        <article class={`design-card accent-${d.accent}`} data-design data-slug={d.slug} data-title={d.title}>
          <div class="design-img">
            <img src={imgUrl(d.slug, 'black')} alt={`${d.title} design on a black tee`} loading="lazy" width="1000" height="1000" data-black={imgUrl(d.slug, 'black')} data-white={imgUrl(d.slug, 'white')} />
          </div>
          <div class="design-body">
            <span class="tag">{d.art} · {d.region}</span>
            <h3>{d.title}</h3>
            <div class="swatches" role="group" aria-label="Tee color">
              <button type="button" class="swatch black" data-color="black" aria-pressed="true" aria-label="Show on black tee"></button>
              <button type="button" class="swatch white" data-color="white" aria-pressed="false" aria-label="Show on white tee"></button>
            </div>
            <span class="design-price">${PRICING.one} · 2 for ${PRICING.two}</span>
            <div class="size-row">
              <label for={`size-${d.slug}`}>Size</label>
              <select id={`size-${d.slug}`} class="size-select">
                {SIZES.map((s) => <option value={s} selected={s === 'M'}>{s}</option>)}
              </select>
              <button type="button" class="btn primary small add-basket">Add to basket</button>
            </div>
            <a class="btn primary small" href={mailtoFor(d.title)}>Email us about this design</a>
            <a class="btn whatsapp small" href={whatsappFor(d.title)} rel="noopener" target="_blank">WhatsApp us</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="studio-band how-band">
    <div>
      <span class="kicker">How ordering works</span>
      <h2>Fill your basket, send us the order.</h2>
      <p>
        Tees are <strong>${PRICING.one} for one</strong> or <strong>${PRICING.two} for two</strong> (mix and match), ${BULK.each} each for 3 to 9 and ${BULK.bigEach} each for {BULK.bigFrom} or more, with free pickup or
        local delivery in {LOCAL_AREA}, CA. Somewhere else? Send the order anyway and we'll quote shipping.
        Front + back prints, women's V-necks, custom designs and concept + design cost a little more; we'll quote you.
      </p>
    </div>
    <ul class="roadmap">
      <li><strong>1. Add tees to your basket</strong><span>pick the design, color and size (S, M, L)</span></li>
      <li><strong>2. Send the order</strong><span>by WhatsApp or email · {WHATSAPP_DISPLAY} (@{WHATSAPP_USERNAME})</span></li>
      <li><strong>3. Pay and pick up</strong><span>{STRIPE_LINKS.one ? 'pay by card from the basket' : 'we reply with how to pay'} · pickup or local delivery</span></li>
    </ul>
  </section>

  <section class="pricing-info" id="prices">
    <h2 class="section-title">Prices &amp; delivery</h2>
    <div class="info-grid">
      <div class="info-card">
        <h3>How we price tees</h3>
        <div class="table-wrap">
          <table class="price-table">
            <thead><tr><th scope="col">Tees</th><th scope="col">Price</th></tr></thead>
            <tbody>
              <tr><td>1</td><td><strong>${PRICING.one}</strong></td></tr>
              <tr><td>2</td><td><strong>${PRICING.two}</strong> for both</td></tr>
              <tr><td>3 to {BULK.bigFrom - 1}</td><td><strong>${BULK.each} each</strong> <span>(5 tees = ${5 * BULK.each})</span></td></tr>
              <tr><td>{BULK.bigFrom} or more</td><td><strong>${BULK.bigEach} each</strong> <span>({BULK.bigFrom} tees = ${BULK.bigFrom * BULK.bigEach})</span></td></tr>
            </tbody>
          </table>
        </div>
        <p>Mix and match any designs, colors and sizes, including tees from <a href={ETSY_URL} rel="noopener">our Etsy shop</a>: the price depends only on how many tees you order. Add Etsy picks in the basket's “Etsy tees” box and they're counted in the total.
          Prices are for a front print on a classic crew-neck tee. Front + back prints, women's V-necks and custom designs are quoted separately.</p>
      </div>
      <div class="info-card">
        <h3>Pickup &amp; delivery</h3>
        <p><strong>Free</strong> pickup in Fremont, or free delivery to {LOCAL_AREA}. Type your ZIP code in the basket to check.</p>
        <p><strong>Anywhere else:</strong> you can still order. We add shipping based on your ZIP code and message you the total before you pay.</p>
      </div>
      <div class="info-card">
        <h3>Paying</h3>
        <p>Send us your order from the basket by WhatsApp or email. Every order gets a code like <strong class="nowrap">SJ-1234</strong> so we can match it up.</p>
        <p>{STRIPE_LINKS.one
          ? `For 1 or 2 tees in our local area, you can pay by card straight from the basket. For bigger orders or shipping, we'll send you a card payment link for the exact total.`
          : `We'll reply with your total and how to pay.`}</p>
      </div>
    </div>
  </section>



  <button type="button" class="basket-fab" id="basket-open" aria-haspopup="dialog" hidden>
    Basket <span class="basket-count" id="basket-count">0</span>
  </button>

  <dialog class="basket" id="basket" aria-labelledby="basket-title">
    <div class="basket-head">
      <h2 id="basket-title">Your basket</h2>
      <button type="button" class="basket-close" id="basket-close" aria-label="Close basket">×</button>
    </div>
    <p class="basket-empty" id="basket-empty">Your basket is empty. Pick a design, a color and a size, then press “Add to basket”.</p>
    <ul class="basket-items" id="basket-items"></ul>
    <div id="basket-body">
      <p class="basket-note" id="basket-bulk" hidden></p>
      <div class="basket-field">
        <label for="basket-etsy">Etsy tees (optional)</label>
        <textarea id="basket-etsy" rows="2" placeholder="One per line: listing name, color, size"></textarea>
        <p class="basket-note">Adding tees from our Etsy shop? Same prices, counted in your total.</p>
      </div>
      <fieldset class="basket-field">
        <legend>How you'll get it</legend>
        <label><input type="radio" name="handoff" value="pickup" checked /> Pickup in Fremont, CA (free)</label>
        <label><input type="radio" name="handoff" value="delivery" /> Delivery (free in our local area, listed below)</label>
      </fieldset>
      <p class="basket-note">Free delivery area: {LOCAL_AREA}.</p>
      <div class="basket-field" id="zip-row" hidden>
        <label for="basket-zip">Delivery ZIP code</label>
        <input id="basket-zip" inputmode="numeric" autocomplete="postal-code" maxlength="5" pattern="[0-9]{5}" placeholder="94539" />
        <p class="basket-note" id="zip-msg" aria-live="polite"></p>
      </div>
      <div class="basket-field">
        <label for="basket-name">Your name</label>
        <input id="basket-name" autocomplete="name" placeholder="So we know whose order it is" />
      </div>
      <div class="basket-total">
        <span>Total</span>
        <strong id="basket-total"></strong>
      </div>
      <p class="basket-ref">Order code <strong id="basket-code"></strong></p>
      <div class="basket-actions">
        <a class="btn whatsapp" id="send-whatsapp" rel="noopener" target="_blank">Send order on WhatsApp</a>
        <a class="btn ghost" id="send-email">Send order by email</a>
        <a class="btn primary" id="pay-now" rel="noopener" target="_blank" hidden>Pay now by card</a>
      </div>
      <p class="basket-note" id="pay-msg"></p>
    </div>
  </dialog>

  <script is:inline define:vars={{ PRICING, BULK, STRIPE_LINKS, LOCAL_ZIPS, WHATSAPP_NUMBER, CONTACT_EMAIL }}>
    var KEY = 'sidjam-basket-v1';
    var state = { items: [], code: '', handoff: 'pickup', zip: '', name: '', etsy: '' };
    function etsyLines() { return (state.etsy || '').split('\n').map(function (l) { return l.trim(); }).filter(Boolean); }
    function teeCount() { return state.items.length + etsyLines().length; }
    try { var saved = JSON.parse(localStorage.getItem(KEY) || 'null'); if (saved && Array.isArray(saved.items)) state = Object.assign(state, saved); } catch (e) {}
    function save() { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} }
    function newCode() { return 'SJ-' + String(Math.floor(1000 + Math.random() * 9000)); }
    if (!state.code) state.code = newCode();

    var $ = function (id) { return document.getElementById(id); };
    var dlg = $('basket'), fab = $('basket-open');
    var localSet = {}; LOCAL_ZIPS.forEach(function (z) { localSet[z] = true; });

    function zipStatus() {
      if (state.handoff !== 'delivery') return 'local';
      if (!/^\d{5}$/.test(state.zip)) return 'missing';
      return localSet[state.zip] ? 'local' : 'far';
    }
    function eachFor(n) { return n >= BULK.bigFrom ? BULK.bigEach : BULK.each; }
    function priceFor(n) { return n === 1 ? PRICING.one : n === 2 ? PRICING.two : n * eachFor(n); }

    function orderText() {
      var n = teeCount(), zs = zipStatus(), price = priceFor(n);
      var lines = ['Hi SidJam Studio! New order ' + state.code + (state.name ? ' from ' + state.name : '') + ':', ''];
      state.items.forEach(function (it, i) { lines.push((i + 1) + '. ' + it.title + ' – ' + it.color + ' tee, size ' + it.size); });
      etsyLines().forEach(function (l, i) { lines.push((state.items.length + i + 1) + '. Etsy: ' + l); });
      lines.push('');
      if (state.handoff === 'pickup') lines.push('Pickup in Fremont');
      else lines.push('Delivery to ZIP ' + (state.zip || '?') + (zs === 'far' ? ' (outside local area – please quote shipping)' : ''));
      var priceLine = n >= BULK.from ? n + ' tees × $' + eachFor(n) + ' = $' + price : '$' + price;
      if (zs === 'local') lines.push('Total: ' + priceLine);
      else lines.push('Tees: ' + priceLine + ' + shipping. Please send the total with shipping.');
      return lines.join('\n');
    }

    function render() {
      var n = teeCount(), zs = zipStatus(), price = priceFor(n);
      fab.hidden = state.items.length === 0 && !dlg.open;
      $('basket-count').textContent = n;
      $('basket-empty').hidden = state.items.length > 0;
      $('basket-body').hidden = state.items.length === 0;
      var bulk = $('basket-bulk');
      bulk.hidden = n < BULK.from;
      bulk.textContent = n >= BULK.bigFrom
        ? 'Bulk price: $' + BULK.bigEach + ' each for ' + BULK.bigFrom + ' or more tees.'
        : 'Bulk price: $' + BULK.each + ' each for 3–9 tees. Add ' + (BULK.bigFrom - n) + ' more to get $' + BULK.bigEach + ' each.';
      $('zip-row').hidden = state.handoff !== 'delivery';
      $('basket-code').textContent = state.code;

      var ul = $('basket-items'); ul.innerHTML = '';
      state.items.forEach(function (it, i) {
        var li = document.createElement('li');
        var img = document.createElement('img'); img.src = it.img; img.alt = ''; img.width = 56; img.height = 56;
        var txt = document.createElement('div');
        var t = document.createElement('strong'); t.textContent = it.title;
        var sub = document.createElement('span'); sub.textContent = it.color + ' tee · size ' + it.size;
        txt.append(t, sub);
        var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'basket-remove'; rm.textContent = 'Remove';
        rm.setAttribute('aria-label', 'Remove ' + it.title);
        rm.addEventListener('click', function () { state.items.splice(i, 1); save(); render(); });
        li.append(img, txt, rm); ul.appendChild(li);
      });

      var zm = $('zip-msg');
      zm.className = 'basket-note';
      if (zs === 'missing') zm.textContent = 'Enter your 5-digit ZIP so we can check you are in our delivery area.';
      else if (zs === 'far') { zm.textContent = 'That ZIP is outside our free delivery area. You can still order: we\'ll message you the price with shipping.'; zm.className = 'basket-note warn'; }
      else zm.textContent = 'Great, you are in our free local delivery area.';

      var total = $('basket-total');
      var label = '$' + price + (n === 2 ? ' for 2 tees' : n >= BULK.from ? ' (' + n + ' × $' + eachFor(n) + ')' : '');
      total.textContent = zs === 'far' ? label + ' + shipping' : label;

      var text = orderText(), ready = zs !== 'missing';
      var wa = $('send-whatsapp'), em = $('send-email');
      [wa, em].forEach(function (a) { a.classList.toggle('disabled', !ready); a.setAttribute('aria-disabled', String(!ready)); });
      wa.href = ready ? 'https://wa.me/' + WHATSAPP_NUMBER + '?text=' + encodeURIComponent(text) : '#';
      em.href = ready ? 'mailto:' + CONTACT_EMAIL + '?subject=' + encodeURIComponent('Order ' + state.code) + '&body=' + encodeURIComponent(text) : '#';

      var link = etsyLines().length ? '' : n === 1 ? STRIPE_LINKS.one : n === 2 ? STRIPE_LINKS.two : '';
      var canPay = !!link && zs === 'local';
      var pay = $('pay-now');
      pay.hidden = !canPay;
      if (canPay) pay.href = link + (link.indexOf('?') < 0 ? '?' : '&') + 'client_reference_id=' + encodeURIComponent(state.code);
      $('pay-msg').textContent = canPay
        ? 'Send your order first, then pay. Your order code ' + state.code + ' links the two.'
        : (n >= BULK.from || etsyLines().length) && zs === 'local' && STRIPE_LINKS.one
          ? 'Send us the order and we\'ll reply with a card payment link for $' + price + '.'
          : 'Send us the order and we\'ll reply with how to pay.';
    }

    document.querySelectorAll('[data-design]').forEach(function (card) {
      card.querySelector('.add-basket').addEventListener('click', function () {
        var pressed = card.querySelector('.swatch[aria-pressed="true"]');
        var color = pressed ? pressed.getAttribute('data-color') : 'black';
        var img = card.querySelector('img');
        state.items.push({ slug: card.dataset.slug, title: card.dataset.title, color: color, size: card.querySelector('.size-select').value, img: img.getAttribute('data-' + color) });
        save(); render();
        if (!dlg.open) dlg.showModal();
      });
    });
    fab.addEventListener('click', function () { dlg.showModal(); render(); });
    $('basket-close').addEventListener('click', function () { dlg.close(); });
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', render);
    document.querySelectorAll('input[name="handoff"]').forEach(function (r) {
      r.checked = r.value === state.handoff;
      r.addEventListener('change', function () { state.handoff = r.value; save(); render(); });
    });
    $('basket-zip').value = state.zip;
    $('basket-zip').addEventListener('input', function (e) { state.zip = e.target.value.replace(/\D/g, '').slice(0, 5); e.target.value = state.zip; save(); render(); });
    $('basket-etsy').value = state.etsy || '';
    $('basket-etsy').addEventListener('input', function (e) { state.etsy = e.target.value; save(); render(); });
    $('basket-name').value = state.name;
    $('basket-name').addEventListener('input', function (e) { state.name = e.target.value.trim(); save(); render(); });
    ['send-whatsapp', 'send-email'].forEach(function (id) {
      $(id).addEventListener('click', function (e) { if (this.getAttribute('aria-disabled') === 'true') { e.preventDefault(); $('basket-zip').focus(); } });
    });
    render();
  </script>

  <script is:inline>
    document.querySelectorAll('[data-design]').forEach(function (card) {
      var img = card.querySelector('img');
      card.querySelectorAll('.swatch').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var c = btn.getAttribute('data-color');
          img.src = img.getAttribute('data-' + c);
          img.alt = img.alt.replace(/on a (black|white) tee/, 'on a ' + c + ' tee');
          card.querySelectorAll('.swatch').forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
        });
      });
    });
  </script>
</Base>
